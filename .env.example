# ─────────────────────────────────────────────────────────────────────────────
# Образец настроек развёртывания. Скопируйте в .env и заполните:
#
#   cp .env.example .env
#
# Файл .env перечислен в .gitignore: в нём пароль от базы и токен бота.
# В образ он не попадает — см. .dockerignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Публичный адрес ──────────────────────────────────────────────────────────
# Домен, по которому открывается сайт и мини-апп. Caddy получит на него
# сертификат Let's Encrypt сам — но домен должен уже указывать A-записью
# на IP сервера, и порты 80 и 443 должны быть открыты.
#
# Домена нет? Возьмите sslip.io: он резолвит любой IP, вписанный в имя,
# и Let's Encrypt выдаёт на такое имя настоящий сертификат.
# Пример для сервера 203.0.113.10:
#   PUBLIC_URL=https://203.0.113.10.sslip.io
PUBLIC_URL=https://trainer.example.com

# ── Порт HTTPS ───────────────────────────────────────────────────────────────
# 443, если он свободен. Если его занимает другая служба, укажите другой
# порт — адрес станет https://домен:9443.
#
# Порт 80 освободить придётся в любом случае: через него Let's Encrypt
# подтверждает владение доменом.
HTTPS_PORT=443

# ── База данных ──────────────────────────────────────────────────────────────
POSTGRES_DB=english_trainer
POSTGRES_USER=postgres
# Придумайте пароль. База наружу не публикуется, но пароль всё равно не
# должен быть словарным: сосед по сети в докер-сети — тоже угроза.
POSTGRES_PASSWORD=

# ── Токены ───────────────────────────────────────────────────────────────────
# Секрет подписи токенов доступа. Не короче 32 байт.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Имя бота без «@» — из него собирается ссылка привязки аккаунта.
TELEGRAM_BOT_USERNAME=

# ── Почта: письмо со ссылкой для сброса пароля ───────────────────────────────
# Пусто — приложение работает и без почты: письмо со ссылкой выводится в журнал
# контейнера (docker compose logs api), а форма «забыли пароль» честно говорит
# об этом.
#
# EMAIL_PROVIDER выбирает способ отправки:
#   smtp  — обычная почта (параметры EMAIL_SMTP_* ниже)
#   brevo — HTTP API, нужен там, где хостинг закрывает исходящие порты 25/465/587.
#           Проверить: timeout 8 bash -c 'exec 3<>/dev/tcp/portquiz.net/587'
#           Если команда молчит, исходящий порт закрыт и SMTP не заработает.
EMAIL_PROVIDER=smtp

# Пример для SMTP — Mail.ru. Порт 587, а не 465: на 465 шифрование начинается
# с первого байта, и его понимает не всякий клиент. Пароль — «пароль для
# внешнего приложения» из настроек безопасности Mail.ru, а не пароль от ящика.
EMAIL_SMTP_HOST=smtp.mail.ru
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=you@mail.ru
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SSL=true

# Ключ API Brevo (xkeysib-…). Нужен только при EMAIL_PROVIDER=brevo.
# Адрес отправителя должен быть подтверждён в Brevo — он пришлёт на него письмо.
EMAIL_BREVO_API_KEY=

# Сколько секунд ждать почтовый сервис, прежде чем показать ошибку.
EMAIL_TIMEOUT_SECONDS=20

# Адрес отправителя: у большинства провайдеров он должен совпадать с логином.
EMAIL_FROM=you@mail.ru
# Имя отправителя, которое видит получатель.
EMAIL_FROM_NAME=EnglishTrainer

# ── Поиск: счётчик и подтверждение прав ──────────────────────────────────────
# Номер счётчика Яндекс.Метрики. Пусто — счётчик не подключается, и страницы
# не грузят лишний скрипт. Номер виден в панели Метрики рядом с названием.
SEO_METRIKA_ID=

# Запись сессий (Вебвизор). false — только цифры: страницы, источники, отказы.
# true включает запись движений и ввода, а это персональные данные: нужны
# согласие посетителя и политика обработки. Галочка в панели Метрики записи
# не включает — включает только этот параметр.
SEO_METRIKA_WEBVISOR=false

# Имя файла подтверждения прав, которое выдаёт панель вебмастера. Файл нужно
# только назвать здесь — отдавать его будет само приложение по адресу
# https://домен/<имя>. Пример: yandex_1a2b3c4d5e6f7890.html
SEO_YANDEX_VERIFICATION_FILE=

# То же для Google Search Console. Пример: google1a2b3c4d5e6f7890.html
SEO_GOOGLE_VERIFICATION_FILE=

# ── Реклама на страницах каталога ────────────────────────────────────────────
# Пока сайт не одобрен в РСЯ, оставьте false: загрузчик рекламы не подключается,
# и страницы не делают ни одного стороннего запроса.
# После одобрения: ADS_ENABLED=true и ADS_BLOCK_ID=идентификатор блока из панели
# (вида R-A-1234567-1). Перезапуск контейнера api — и реклама появится только
# на /decks и /decks/{slug}, внутрь тренировки она не попадает.
ADS_ENABLED=false
ADS_BLOCK_ID=

# ── Реквизиты оператора для политики обработки данных ────────────────────────
# По 152-ФЗ политика должна называть оператора. Пустое имя — страница покажет
# «администратор сайта EnglishTrainer»; для реальной публикации лучше заполнить.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_CONTACT_EMAIL=passwordenglishtrainer@mail.ru
