<Project>

  <!--
    Общие настройки для всех проектов решения.

    Вынесены в один файл, а не размазаны по четырём .csproj: правила «какой язык,
    какая платформа, как относимся к предупреждениям» должны быть одинаковыми
    во всём решении. Иначе через полгода один проект собирается с Nullable,
    другой — без, и это выясняется в самый неподходящий момент.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Предупреждение — это ошибка. Компилятор в .NET предупреждает ровно
         о том, что потом становится багом в проде: null, необработанный
         результат, устаревший API. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Аудит уязвимостей NuGet ходит на nuget.org за списком уязвимых пакетов.
      В окружении без доступа к сети он возвращает NU1900, а из-за
      TreatWarningsAsErrors это ломает restore целиком.
      Отключено осознанно; при работе с сетью верните true.
    -->
    <NuGetAudit>false</NuGetAudit>

    <!--
      Версия приложения. Одна на всё решение и на все процессы: её показывает
      интерфейс на странице «Что нового», и та же версия уходит в сборку.

      Номер меняется вместе с выкаткой, а не «когда-нибудь»: по нему человек
      понимает, обновилось ли приложение и о каких правках читает описание.
      Список правок живёт рядом, в wwwroot/js/pages/updates.js, и его последняя
      запись должна называться так же.
    -->
    <Version>1.3.0</Version>
  </PropertyGroup>

</Project>
