{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

      // Сообщение «No action descriptors found» относится к MVC. Приложение
      // построено на minimal API, поэтому к нему это не относится — без фильтра
      // оно выглядит как ошибка настройки при каждом запуске.
      "Microsoft.AspNetCore.Mvc.Infrastructure.DefaultActionDescriptorCollectionProvider": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    // Порт 5433 — контейнер из docker-compose.yml. Своя база задаётся здесь,
    // в user-secrets или переменной окружения ConnectionStrings__Postgres.
    "Postgres": "Host=localhost;Port=5433;Database=english_trainer;Username=postgres;Password=nail"
  },

  "Jwt": {
    // Секрета здесь нет намеренно: в развёртывании он приходит из переменной
    // окружения Jwt__Secret или из user-secrets. Без секрета приложение не стартует.
    "Issuer": "EnglishTrainer",
    "Audience": "EnglishTrainer",
    "LifetimeMinutes": 10080
  },

  "Database": {
    // В развёртывании схему обновляют отдельным шагом, до запуска новых экземпляров:
    // dotnet run --project EnglishTrainer.Api -- migrate
    "AutoMigrate": false,
    "SeedOnStartup": false
  },

  "ReverseProxy": {
    // Включается, когда приложение стоит за обратным прокси (Caddy, nginx).
    // Без этого ссылки строятся по внутреннему адресу и схеме, а перенаправление
    // на HTTPS зацикливается: прокси присылает обычный HTTP, приложение отвечает
    // «перейди на HTTPS», и так по кругу. В docker-compose.prod.yml включается
    // переменной окружения ReverseProxy__Enabled=true.
    "Enabled": false
  },

  "Email": {
    // Почта нужна ровно для одного письма — ссылки на сброс пароля.
    // Пустой Host — рабочий режим, а не ошибка: письмо выводится в журнал
    // сервера, и администратор видит ссылку в окне запуска. Секреты SMTP
    // задаются переменными окружения (Email__Smtp__Password), а не здесь.
    //
    // Provider: smtp — обычная отправка; brevo — через HTTP API, если хостинг
    // закрывает исходящие почтовые порты (25, 465, 587). Это не редкость:
    // так провайдеры борются со спамом, и обойти это изнутри нельзя.
    "Provider": "smtp",

    "Smtp": {
      "Host": "",
      "Port": 587,
      "User": "",
      "Password": "",
      "EnableSsl": true
    },

    "Brevo": {
      // Ключ API Brevo (xkeysib-…). Хранится вне репозитория.
      "ApiKey": ""
    },

    // Сколько секунд ждать почтовый сервис. Умолчание SmtpClient — 100 секунд,
    // и на хостинге с закрытым исходящим портом форма «забыли пароль» висела бы
    // всё это время, прежде чем показать ошибку.
    "TimeoutSeconds": 20,

    // Адрес отправителя. Обязателен вместе с сервером: без него письмо не уходит.
    "From": "",
    "FromName": "EnglishTrainer",

    // Публичный адрес приложения для ссылок в письмах. Пусто — берётся из запроса;
    // за обратным прокси задайте явно (в развёртывании — PUBLIC_URL).
    "PublicUrl": ""
  },

  "Seo": {
    // Публичный адрес сайта: из него собираются sitemap.xml, canonical и ссылки
    // в разметке schema.org. Значение совпадает с Email:PublicUrl и в
    // развёртывании приходит из той же переменной PUBLIC_URL.
    "PublicBaseUrl": "https://englishrainer.site",

    // Номер счётчика Яндекс.Метрики. Значение по умолчанию — боевой счётчик:
    // appsettings.json едет на сервер вместе с кодом, а переменные окружения
    // из docker-compose туда не попадают (этот файл на сервере свой и деплой
    // его не перезаписывает). Локальные заходы в статистику не попадут:
    // в настройках счётчика включён приём данных только с englishrainer.site.
    //
    // Пусто — счётчик не подключается, страницы не грузят лишний скрипт.
    // Другой счётчик (например, тестовый) задаётся Seo__YandexMetrikaId.
    "YandexMetrikaId": "113772679",

    // Запись сессий (Вебвизор). Выключено намеренно: это персональные данные,
    // для них нужны согласие посетителя и политика обработки. Галочка
    // в панели Метрики сама записи не включает — включает этот параметр.
    "MetrikaWebvisor": false,

    // Имена файлов подтверждения прав, которые выдаёт панель вебмастера:
    // yandex_….html для Яндекса и google….html для Google. Пусто — маршруты
    // подтверждения не регистрируются вовсе.
    //
    // Сейчас прописан файл для englishrainer.site. Токен привязан к домену:
    // при следующем переезде Вебмастер выдаст новый, и это значение придётся
    // заменить — иначе старый файл будет отвечать на адрес, которого нет в панели.
    // Файл должен отвечать постоянно: Вебмастер перепроверяет права и после
    // регистрации, а не только в момент подтверждения.
    "YandexVerificationFile": "yandex_40975086de533cb4.html",
    "GoogleVerificationFile": ""
  },

  // ── Реквизиты для юридических страниц ─────────────────────────────────────
  // По 152-ФЗ политика должна называть оператора персональных данных. Статус
  // (самозанятый, ИП, организация) и ИНН заполняются здесь, а не в разметке:
  // меняются они независимо от кода. Пустое имя — страница покажет нейтральное
  // «администратор сайта EnglishTrainer»; для публикации лучше заполнить.
  "Legal": {
    "OperatorName": "",
    "OperatorInn": "",
    "ContactEmail": "passwordenglishtrainer@mail.ru",
    "UpdatedOn": "27 октября 2026"
  },

  // ── Реклама на страницах каталога ─────────────────────────────────────────
  // Выключено, пока сайт не прошёл модерацию РСЯ. Когда блок одобрят, вписать
  // идентификатор вида R-A-1234567-1 и поставить Enabled = true. Пока реклама
  // выключена, загрузчик РСЯ не подключается вообще — ни одного стороннего
  // запроса со страниц.
  "Ads": {
    "Enabled": false,
    "BlockId": ""
  }
}
