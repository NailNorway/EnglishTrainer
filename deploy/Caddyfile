# ─────────────────────────────────────────────────────────────────────────────
# Caddy: HTTPS и проксирование на приложение.
#
# Caddy выбран вместо nginx ради одной строки конфигурации: он сам получает
# и продлевает сертификат Let's Encrypt, сам перенаправляет HTTP на HTTPS
# и сам разбирается с современными параметрами TLS. В nginx то же самое —
# это certbot, таймер продления и полсотни строк конфигурации, которые надо
# поддерживать.
#
# Адрес сайта приходит переменной SITE_ADDRESS из docker-compose.prod.yml.
# ─────────────────────────────────────────────────────────────────────────────

{$SITE_ADDRESS} {
	tls {
		issuer acme {
			# Владение доменом подтверждается только через порт 80.
			#
			# По умолчанию Caddy сначала пробует TLS-ALPN на 443 — а 443 на
			# сервере может быть занят другой службой, и занять его приложение
			# не сможет. HTTP-01 работает через 80-й порт, который в такой
			# конфигурации остаётся за Caddy, поэтому проверка проходит
			# независимо от того, кто слушает 443.
			disable_tlsalpn_challenge
		}
	}

	# Сжатие заметно на словаре и статике интерфейса: JSON со словами
	# сжимается в разы.
	encode zstd gzip

	# Предел размера тела запроса.
	#
	# Директива стоит на уровне сайта, а не внутри reverse_proxy: внутри блока
	# прокси Caddy её не знает и отказывается читать конфигурацию целиком.
	# Значение больше предела в приложении (2 МиБ на аватар), чтобы сервер
	# успел ответить понятным «файл слишком большой» вместо обрыва соединения.
	request_body {
		max_size 4MB
	}

	# Заголовки X-Forwarded-* Caddy подставляет сам, и приложение настроено
	# им доверять (ReverseProxy__Enabled). Без этого ссылка для сброса пароля
	# указывала бы на внутренний адрес вида http://api:8080.
	reverse_proxy api:8080

	# Заголовки безопасности. Строгая политика CSP здесь не задаётся
	# намеренно: интерфейс подключает скрипт Telegram с telegram.org, а также
	# использует Web Speech API и встроенные стили — политику пришлось бы
	# ослаблять до бесполезной.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Мини-апп открывается внутри Telegram: запрет на встраивание в чужой
		# фрейм здесь только мешал бы.
		-Server
	}

	log {
		output stdout
		format console
	}
}
